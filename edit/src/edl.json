 "cues": [
  {
   "text": "Son las 2 de la mañana,",
   "sf": 0,
   "ef": 24
  },
  {
   "text": "otra vez te cortaron la *luz*",
   "sf": 25,
   "ef": 69
  },
  {
   "text": "y tu casa ahora se convierte en un *horno*",
   "sf": 70,
   "ef": 122
  },
  {
   "text": "durante las próximas 6 horas.",
   "sf": 123,
   "ef": 189
  },
  {
   "text": "Sabes que no vas a dormir nada,",
   "sf": 190,
   "ef": 223
  },
  {
   "text": "mañana tienes que trabajar temprano",
   "sf": 224,
   "ef": 272
  },
  {
   "text": "y tus hijos empiezan a llorar.",
   "sf": 273,
   "ef": 332
  },
  {
   "text": "Es la impotencia de ver",
   "sf": 332,
   "ef": 358
  },
  {
   "text": "cómo se te daña la comida en la *nevera*.",
   "sf": 359,
   "ef": 424
  },
  {
   "text": "Se te cae el *internet*",
   "sf": 425,
   "ef": 448
  },
  {
   "text": "a la mitad de un trabajo importante",
   "sf": 449,
   "ef": 481
  },
  {
   "text": "y saber que tú y tu familia",
   "sf": 482,
   "ef": 539
  },
  {
   "text": "se van a trasnochar.",
   "sf": 540,
   "ef": 589
  },
  {
   "text": "El verdadero lujo hoy",
   "sf": 590,
   "ef": 620
  },
  {
   "text": "no es un carro del año,",
   "sf": 621,
   "ef": 653
  },
  {
   "text": "es la *tranquilidad* de tu familia.",
   "sf": 654,
   "ef": 698
  },
  {
   "text": "En *ALK* no te instalamos un equipito barato",
   "sf": 699,
   "ef": 778
  },
  {
   "text": "para prender 3 bombillos",
   "sf": 779,
   "ef": 818
  },
  {
   "text": "que se te va a dañar en 3 meses.",
   "sf": 819,
   "ef": 885
  },
  {
   "text": "Nosotros montamos",
   "sf": 886,
   "ef": 904
  },
  {
   "text": "infraestructura eléctrica *profesional*,",
   "sf": 905,
   "ef": 986
  },
  {
   "text": "blindada contra picos de voltaje.",
   "sf": 987,
   "ef": 1039
  },
  {
   "text": "Cero ruido de plantas eléctricas,",
   "sf": 1040,
   "ef": 1079
  },
  {
   "text": "cero humo y cero mantenimiento.",
   "sf": 1080,
   "ef": 1136
  },
  {
   "text": "Opción esencial desde *1.500 dólares*,",
   "sf": 1137,
   "ef": 1192
  },
  {
   "text": "diseñada para casas, apartamentos u oficinas.",
   "sf": 1193,
   "ef": 1271
  },
  {
   "text": "Te da de *5 a 6 horas* de autonomía real",
   "sf": 1272,
   "ef": 1328
  },
  {
   "text": "para mantener activos 2 ventiladores",
   "sf": 1329,
   "ef": 1395
  },
  {
   "text": "y iluminación LED completa,",
   "sf": 1396,
   "ef": 1428
  },
  {
   "text": "televisores y tu internet encendido",
   "sf": 1429,
   "ef": 1481
  },
  {
   "text": "para que nunca dejes de producir.",
   "sf": 1482,
   "ef": 1536
  },
  {
   "text": "Hogar funcional desde *3.100 dólares*,",
   "sf": 1537,
   "ef": 1594
  },
  {
   "text": "el equilibrio perfecto.",
   "sf": 1595,
   "ef": 1628
  },
  {
   "text": "Cuenta con *9,6 kWh* de energía",
   "sf": 1629,
   "ef": 1685
  },
  {
   "text": "para respaldar tu nevera,",
   "sf": 1686,
   "ef": 1740
  },
  {
   "text": "iluminación, internet",
   "sf": 1741,
   "ef": 1773
  },
  {
   "text": "y un aire acondicionado de *12.000 BTU*,",
   "sf": 1774,
   "ef": 1843
  },
  {
   "text": "para que duermas fresco y protejas tus alimentos",
   "sf": 1844,
   "ef": 1894
  },
  {
   "text": "sin turnar los equipos.",
   "sf": 1895,
   "ef": 1950
  },
  {
   "text": "Sistema Elite 6000 desde *5.150 dólares*,",
   "sf": 1951,
   "ef": 2039
  },
  {
   "text": "para quienes no aceptan",
   "sf": 2040,
   "ef": 2094
  },
  {
   "text": "interrupciones en su confort.",
   "sf": 2095,
   "ef": 2127
  },
  {
   "text": "Es un tanque masivo de *19,2 kWh*",
   "sf": 2128,
   "ef": 2203
  },
  {
   "text": "de autonomía real.",
   "sf": 2204,
   "ef": 2245
  },
  {
   "text": "Mantiene encendidos en simultáneo",
   "sf": 2246,
   "ef": 2284
  },
  {
   "text": "2 aires acondicionados de *12.000 BTU*.",
   "sf": 2285,
   "ef": 2351
  },
  {
   "text": "Nevera, freezer, computadora",
   "sf": 2352,
   "ef": 2387
  },
  {
   "text": "y toda tu casa funcionando",
   "sf": 2388,
   "ef": 2427
  },
  {
   "text": "como si nunca se hubiese ido la luz.",
   "sf": 2428,
   "ef": 2488
  },
  {
   "text": "Lo mejor de todo es que toda nuestra ingeniería",
   "sf": 2489,
   "ef": 2559
  },
  {
   "text": "es 100 % escalable",
   "sf": 2560,
   "ef": 2601
  },
  {
   "text": "a *energía solar* en el futuro.",
   "sf": 2602,
   "ef": 2654
  },
  {
   "text": "Deja de sufrir por la red eléctrica",
   "sf": 2655,
   "ef": 2705
  },
  {
   "text": "y toma el control de tu hogar hoy mismo.",
   "sf": 2706,
   "ef": 2767
  },
  {
   "text": "Haz clic abajo,",
   "sf": 2768,
   "ef": 2792
  },
  {
   "text": "agenda una asesoría técnica *sin costo*",
   "sf": 2793,
   "ef": 2849
  },
  {
   "text": "por parte de nuestro equipo de ingenieros",
   "sf": 2850,
   "ef": 2887
  },
  {
   "text": "y deja que nosotros nos encarguemos del resto.",
   "sf": 2888,
   "ef": 2957
  }
 ],
